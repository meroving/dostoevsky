// PRD §7.6 Finish: ⌥⌘↩ settles a decided group → ⌘⇧C copies the final text.
{"keys": "cmd-d"}
{"alt": "friction", "scope": "word", "variants": ["tension"]}
{"select": {"text": "friction", "at": "start"}}
{"keys": "alt-cmd-down"}
{"expect": {"text_contains": "Most of the tension in writing"}}
{"keys": "alt-cmd-enter"}
{"expect": {"groups": 0, "status": "Settled"}}
{"keys": "cmd-shift-c"}

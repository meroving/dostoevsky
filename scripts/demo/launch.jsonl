// The launch video (scripts/demo_video.sh), on the opening of Crime and Punishment: writing with
// Zen writing and Private mode, then editing: versions flipped in place, a new one added from
// the selection's buttons, AI ideas, a cut, a comment, a Review pass, and the book's chapters.
// Before the recording: the Project panel closed for writing, two word groups, the caret.
{"action": "app::ToggleProject"}
{"action": "app::ToggleProject"}
{"alt": "garret", "scope": "word", "variants": ["closet", "cubbyhole"]}
{"alt": "His garret was under the roof of a high, five-storied house and was more like a cupboard than a room.", "scope": "sentence", "variants": ["He lived under the roof of a tall house, in a room more like a cupboard."]}
{"select": {"text": "was afraid of meeting her.", "at": "end"}}
{"wait": 900}
{"record": "$OUT/raw.mp4", "fps": 30}
{"pointer": false}
{"wait": 400}
// Writing: the next paragraph, the sentence lit; then Private mode.
{"keys": "enter"}
{"typing": "This was not because he was cowardly and abject, quite the contrary. ", "cps": 24}
{"keys": "shift-cmd-h"}
{"wait": 250}
{"typing": "He dreaded meeting anyone at all.", "cps": 22}
{"wait": 500}
{"keys": "shift-cmd-h"}
{"wait": 400}
// Editing: flip a word, then a sentence, through their versions.
{"keys": "cmd-2"}
{"wait": 600}
{"pointer": true}
{"glide": {"group": 0}, "ms": 550}
{"wait": 400}
{"keys": "down"}
{"wait": 600}
{"keys": "down"}
{"wait": 650}
{"glide": {"group": 1}, "ms": 500}
{"wait": 300}
{"keys": "down"}
{"wait": 1000}
// A new version: double-click a word, Alternatives in the buttons over it, type, ↩; then AI ideas.
{"glide": {"text": "hesitation"}, "ms": 500}
{"click": {"text": "hesitation"}, "count": 2}
{"wait": 700}
{"glide": {"text": "hesitation", "offset": [0, -40]}, "ms": 350}
{"click": {"text": "hesitation", "offset": [0, -40]}}
{"wait": 600}
{"typing": "indecision", "cps": 14, "into": "field"}
{"wait": 300}
{"keys": "enter"}
{"wait": 900}
{"action": "page::AiAlternatives"}
{"wait": 1600}
// A cut stays on the page, faded; a comment goes in the margin.
{"glide": [1180, 700], "ms": 400}
{"pointer": false}
{"click": {"text": "He was hopelessly"}}
{"select": "He was hopelessly in debt to his landlady, and was afraid of meeting her."}
{"wait": 450}
{"keys": "cmd-x"}
{"wait": 800}
{"select": "S. Place"}
{"keys": "alt-cmd-m"}
{"wait": 250}
{"typing": "Stolyarny Lane. Name it?", "cps": 16, "into": "comment"}
{"wait": 300}
{"keys": "escape"}
{"select": {"text": "On an exceptionally", "at": "start"}}
// Review: Hard to read marks a sentence and says why; nothing is rewritten.
{"pointer": true}
{"glide": {"tab": "review"}, "ms": 500}
{"click": {"tab": "review"}}
{"wait": 600}
{"keys": "2"}
{"wait": 2600}
// The book: its chapters, and the next one opened.
{"glide": {"tab": "project"}, "ms": 500}
{"click": {"tab": "project"}}
{"wait": 700}
{"glide": [100, 225], "ms": 400}
{"click": [100, 225]}
{"wait": 1700}
{"record_stop": true}
